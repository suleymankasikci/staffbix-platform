# Staffbix — environment variables
# Copy to .env.local for local dev, set on Railway for staging/prod.
# Every variable listed here must be set or the app refuses to boot.
# See docs/05-Infrastructure-Choices.md §10 for the locked decision log.

# ─── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_ADMIN_URL=http://localhost:3000
PUBLIC_MARKETING_URL=http://localhost:3000

# ─── Database (Railway Postgres + pgvector) ───────────────────────────────────
# Railway injects this on the service. Locally point at a Postgres 16 container.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/staffbix

# ─── Redis (Railway Redis: sessions, BullMQ, rate-limits, AI cache) ──────────
REDIS_URL=redis://localhost:6379

# ─── Auth secrets ─────────────────────────────────────────────────────────────
# 32 random hex bytes — mixed into session-id hashing so a DB leak alone cannot
# forge a session cookie. Generate: `openssl rand -hex 32`.
SESSION_HASH_PEPPER=

# 32 random hex bytes — master key-encryption-key. Each tenant's per-tenant
# data-encryption-key (DEK) is wrapped with this. Rotate yearly.
TENANT_KEK_MASTER=

# Optional but strongly recommended in production. Proves a request
# actually came through Cloudflare rather than hitting the Railway
# origin hostname directly. Add a Cloudflare Transform Rule that sets
#   x-edge-proof: <this value>
# on every request. When set, requests without the header get no client
# IP, so a forged `cf-connecting-ip` can no longer walk past IP-scoped
# rate limits. Leave empty to keep the previous (spoofable) behaviour.
TRUSTED_PROXY_SECRET=

# EdDSA keypair (PEM) for mobile JWT access tokens. Generate:
#   openssl genpkey -algorithm ed25519 -out priv.pem
#   openssl pkey -in priv.pem -pubout -out pub.pem
MOBILE_JWT_PRIVATE_KEY=
MOBILE_JWT_PUBLIC_KEY=

# ─── Email (system mail only — Yandex primary, Resend fallback) ──────────────
YANDEX_SMTP_HOST=smtp.yandex.com
YANDEX_SMTP_PORT=465
YANDEX_SMTP_USER=
YANDEX_SMTP_PASS=
SYSTEM_MAIL_FROM="Staffbix <no-reply@staffbix.com>"
RESEND_API_KEY=

# ─── AI ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Payments (Stripe) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TAX_ENABLED=true

# ─── Storage (Cloudflare R2 — S3-compatible) ─────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_ASSETS=staffbix-assets
R2_BUCKET_TENANT=staffbix-tenant
R2_ENDPOINT=https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
# Public-bucket URL Cloudflare auto-generates when you enable Public Dev URL
# on a bucket. Used to serve uploaded assets (PDFs, brand bible exports)
# back to the browser without going through our app.
R2_PUBLIC_URL=

# ─── Observability (Axiom — NOT Sentry) ───────────────────────────────────────
AXIOM_TOKEN=
AXIOM_DATASET=staffbix-dev
AXIOM_ORG_ID=

# ─── Mobile push (Sprint 6) ───────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=

# ─── Social publishing OAuth (X / LinkedIn) ───────────────────────────────────
# Required to connect + publish to X (Twitter) and LinkedIn. Create the
# apps in each developer portal, set the redirect/callback URL to
#   {PUBLIC_APP_URL}/api/integrations/social/twitter/callback
#   {PUBLIC_APP_URL}/api/integrations/social/linkedin/callback
# X app needs scopes: tweet.read tweet.write users.read offline.access (OAuth2, PKCE).
# LinkedIn app needs: openid profile w_member_social.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
